[Unit]
Description=Hidden Letter Game Bot
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/bot/wordgame
ExecStart=/home/ec2-user/.hermes/hermes-agent/venv/bin/python3 main.py
Restart=always
RestartSec=5
EnvironmentFile=/home/ec2-user/bot/wordgame/.env

[Install]
WantedBy=multi-user.target
